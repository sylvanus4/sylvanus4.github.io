{
  "id": "embodied",
  "product": {
    "ko": "Embodied Lab은 조명, 마찰, occlusion, 센서 noise, gripper failure 같은 환경 perturbation을 대규모로 주입해 로봇 policy가 실제로 무너지는 조건을 자동으로 찾아내는 Physical AI reliability platform이다.",
    "en": "Embodied Lab injects environment perturbations at scale, lighting, friction, occlusion, sensor noise, gripper failure, to automatically find where a robot policy actually breaks."
  },
  "howto": {
    "ko": "제어기를 고르고 gripper 결함 확률을 올려 보면서 성공률이 무너지는 지점을 확인하세요.",
    "en": "Pick a controller and raise the gripper-failure probability to see where its success rate collapses."
  },
  "controls": [
    {
      "key": "policy",
      "label": {
        "ko": "제어기",
        "en": "Controller"
      },
      "type": "select",
      "options": [
        {
          "value": "proportional",
          "label": {
            "ko": "단순 비례 제어기",
            "en": "Naive proportional"
          }
        },
        {
          "value": "grasp_offset",
          "label": {
            "ko": "그립-오프셋 보정 제어기",
            "en": "Grasp-offset-aware"
          }
        }
      ]
    },
    {
      "key": "gripper_failure_probability",
      "label": {
        "ko": "gripper 결함 확률",
        "en": "Gripper failure probability"
      },
      "type": "range",
      "options": [
        {
          "value": 0.0,
          "label": {
            "ko": "0%",
            "en": "0%"
          }
        },
        {
          "value": 0.15,
          "label": {
            "ko": "15%",
            "en": "15%"
          }
        },
        {
          "value": 0.3,
          "label": {
