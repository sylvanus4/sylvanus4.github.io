        },
        {
          "value": 0.6,
          "label": {
            "ko": "60%",
            "en": "60%"
          }
        },
        {
          "value": 0.75,
          "label": {
            "ko": "75%",
            "en": "75%"
          }
        }
      ]
    }
  ],
  "outputs": [
    {
      "key": "success_rate",
      "label": {
        "ko": "성공률",
        "en": "Success rate"
